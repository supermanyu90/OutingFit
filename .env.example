# ==============================================================================
# OutingFit Environment Configuration Template (Render Deployment)
# ==============================================================================

# GEMINI_API_KEY: Required for Gemma / Gemini API calls.
# On Render: Configure this under Dashboard -> Environment -> Environment Variables / Secrets.
# NEVER commit the real secret key to source control.
GEMINI_API_KEY="AIzaSy..."

# PORT: The port the HTTP server listens on.
# Render automatically injects PORT (typically 10000). Defaults to 3000 in local dev.
PORT=3000

# NODE_ENV: Application environment ('development' or 'production').
# On Render: Set to 'production'.
NODE_ENV="production"

# APP_URL: Public URL where OutingFit is deployed.
# Example: https://outingfit.onrender.com
APP_URL="https://outingfit.onrender.com"

# WEATHER_API_TIMEOUT_MS: Milliseconds before external weather call aborts to fallback.
# Prevents network lag from delaying user outing advice. Defaults to 5000ms.
WEATHER_API_TIMEOUT_MS=5000

# INFERENCE_TIMEOUT_MS: Milliseconds before LLM inference aborts to deterministic engine.
# Guarantees user receives their advice without waiting indefinitely. Defaults to 8000ms.
INFERENCE_TIMEOUT_MS=8000

# SERPAPI_API_KEY: Optional API key for live SerpApi destination searches.
# Official Docs: https://serpapi.com/search-api
# When omitted, OutingFit operates in calibrated offline/demo mode with verified provenances.
SERPAPI_API_KEY="your_serpapi_key_here"

# SENTRY_DSN: Optional DSN for Sentry Agent Tracing & Error Monitoring.
# SDK: @sentry/node v11.4.0
# When omitted, traces are safely recorded in-memory for local diagnostic inspection.
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
