# ==============================================================================
# OutingFit environment template — copy to .env. Never commit real keys.
# ==============================================================================

# --- Gemma (recommendation engine) -------------------------------------------
# Primary: Gemma 4 on the Gemini API. Get a key at https://aistudio.google.com/
GEMINI_API_KEY=
# Comma-separated, tried in order. gemma-4-31b-it was overloaded (503) when tested on 2026-10-04.
GEMMA_MODEL=gemma-4-26b-a4b-it
# Fallback: local Gemma via Ollama (`ollama pull gemma3:4b`). Set OLLAMA_URL=off to disable.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_GEMMA_MODEL=gemma3:4b
INFERENCE_TIMEOUT_MS=25000
# Gemma 4 thinking: 'minimal' (default, ~3x faster) or 'default' to keep the model's own setting
GEMMA_THINKING_LEVEL=minimal
OLLAMA_TIMEOUT_MS=90000

# --- ElevenLabs (voice) -------------------------------------------------------
# Needs Speech-to-Text, Text-to-Speech and ElevenAgents (convai) permissions.
ELEVENLABS_API_KEY=
# Written by `npm run setup:agent` (creates the agent + client tools and verifies each language):
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_AGENT_LANG_EN=ok|unsupported   (likewise _HI, _MR)
# Optional overrides:
# ELEVENLABS_VOICE_ID_HI=   ELEVENLABS_VOICE_ID_MR=   per-language TTS voices
# ELEVENLABS_TTS_MODEL=eleven_v3              TTS model for spoken summaries (must list the language)
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_AGENT_LLM=gemini-2.5-flash       conversation-only LLM inside the ElevenLabs agent

# --- Weather (Open-Meteo, no key; free tier is non-commercial only) -----------
WEATHER_API_TIMEOUT_MS=5000
WEATHER_CACHE_TTL_SECONDS=600
# A cached forecast older than this is never shown, even as stale:
WEATHER_STALE_MAX_SECONDS=10800

# --- Decision layer -----------------------------------------------------------
# Partial JSON deep-merged over server/decision/config.ts, e.g.
# DECISION_CONFIG_JSON={"uv":{"high":7},"rain":{"probabilityLikelyPct":50}}

# --- Server -------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Optional, unchanged from before -----------------------------------------
SERPAPI_API_KEY=
SENTRY_DSN=
